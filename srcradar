#!/usr/bin/env bash
#
# srcradar - root-level dispatcher for all module scripts.
#
# Resolves <module> <script> from modules/{main,public,private}/ and
# exec's the target. Zero business logic in this file; everything lives
# in the submodule scripts.
#
# Usage:
#   ./srcradar <module> <script> [args...]
#   ./srcradar --list
#   ./srcradar -h|--help
#
# Examples:
#   ./srcradar manage add_business -n <business>
#   ./srcradar pdtm scan -b <business>
#   ./srcradar db init_db
#   ./srcradar daily daily_monitor
#   ./srcradar ymicp icp_mapp_query -b <business>
#
# Module resolution order: modules/private > modules/main > modules/public
# (internal modules override public / default-installed modules)
# Script resolution order: <script>.sh > <script>.py
# (executable bit required for .sh, optional for .py)
#
# The help text lives in the message table (see modules/main/i18n/), so
# --help renders in the configured language. This header is the
# developer-facing description and is not what --help prints.
#

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---- i18n: message tables and language resolution ----
# Locate the repository root by walking up, then reach the i18n module.
# The same snippet works from any directory depth.
_i18n_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && while [ ! -d modules/main/i18n ] && [ "$PWD" != "/" ]; do cd ..; done && pwd)/modules/main/i18n/i18n.sh"
# The path is resolved at runtime, so shellcheck cannot follow it.
# shellcheck source=modules/main/i18n/i18n.sh
[ -f "$_i18n_self" ] && source "$_i18n_self"

usage() {
    t help.srcradar.usage
    exit "${1:-0}"
}

print_help() { usage 0; }

# alias handling: daily/dashboard → modules/main/daily/lib/dashboard.py
# note: this alias must run right after MODULE/SCRIPT are set, because the
# later Resolve module path section resets MODULE_PATH="" (not exported)
# so the alias has to "rewrite" MODULE/SCRIPT to let the later Resolve land on modules/main/daily naturally
list_scripts_alias() {
    if [ "${MODULE}/$SCRIPT" = "daily/dashboard" ]; then
        # change MODULE into a special "daily_dashboard_alias" to make Resolve skip it
        # that does not work, Resolve still looks up a directory by module name. simplest: let the alias set ALIAS_TARGET
        # then the Resolve target section sets TARGET directly from ALIAS_TARGET
        ALIAS_TARGET="/opt/srcradar/modules/main/daily/lib/dashboard.py"
        export ALIAS_TARGET
        export ALIAS_DAILY_LIB=1
    fi
}

list_scripts() {
    local prefix found=0
    for prefix in modules/private modules/main modules/public; do
        [ -d "${ROOT_DIR}/${prefix}" ] || continue
        # scan modules/<m>/<script>.{sh,py} + modules/<m>/lib/<script>.{sh,py}
        # filter out install.sh/init.sh/check.sh (users should not run them directly)
        while IFS= read -r -d '' f; do
            found=1
            rel="${f#${ROOT_DIR}/}"
            mod="$(printf '%s' "${rel}" | awk -F/ '{print $2}')"
            base="$(basename "${f}")"
            printf '  %-12s %s\n' "${mod}" "${base}"
        done < <(find "${ROOT_DIR}/${prefix}" -mindepth 2 -maxdepth 3 \
                    -type f \( -name '*.sh' -o -name '*.py' \) \
                    -not -path '*/__pycache__/*' \
                    -not -name 'install.sh' \
                    -not -name 'init.sh' \
                    -not -name 'check.sh' \
                    -not -name 'init_db.py' \
                    -not -name 'install_cron.sh' \
                    -not -name 'check_schema.py' \
                    -print0 | sort -z)
    done
    if [ "${found}" = "0" ]; then
        printf '  (no scripts found under modules/{main,public,private})\n' >&2
        exit 5
    fi
}

case "${1:-}" in
    -h|--help|"") print_help ;;
    --list)        list_scripts; exit 0 ;;
esac

MODULE="${1:?missing <module>}"
SCRIPT="${2:?missing <script>}"
shift 2
# alias handling (must come after MODULE/SCRIPT are defined, the alias refers to them)
list_scripts_alias

# Resolve module path: main > public > private
MODULE_PATH=""
for prefix in modules/private modules/main modules/public; do
    if [ -d "${ROOT_DIR}/${prefix}/${MODULE}" ]; then
        MODULE_PATH="${prefix}/${MODULE}"
        break
    fi
done

if [ -z "${MODULE_PATH}" ]; then
    # The module is not a local directory of the tree. It can be a virtual
    # module: a module that lives in its own repository and that is not
    # cloned yet. The installer of install.sh holds the list of the virtual
    # modules, so the install of such a module is handed over to it: it
    # clones the repository when it is missing and runs its install.sh.
    if [ "${SCRIPT}" = "install" ]; then
        exec "${ROOT_DIR}/install.sh" --module "${MODULE}" "$@"
    fi
    printf '[srcradar] ERROR: module "%s" not found under modules/{main,public,private}/\n' "${MODULE}" >&2
    printf '       run "%s --list" to see available modules\n' "${BASH_SOURCE[0]}" >&2
    exit 3
fi

# Resolve target file. Prefer .sh (must be +x), fall back to .py (any perm).
# alias check (list_scripts already does this, call it once more before dispatch for safety)
list_scripts_alias

TARGET=""
# alias: prefer ALIAS_TARGET (e.g. daily/dashboard → lib/dashboard.py)
if [ -n "${ALIAS_TARGET:-}" ] && [ -f "${ALIAS_TARGET}" ]; then
    TARGET="${ALIAS_TARGET}"
    SCRIPT="dashboard.py"  # for logging
fi
# look in the module root <SCRIPT>.{sh,py} first, then lib/<SCRIPT>.{sh,py}
for base in "" "lib/"; do
    for ext in sh py; do
        cand="${ROOT_DIR}/${MODULE_PATH}/${base}${SCRIPT}.${ext}"
        if [ -f "${cand}" ]; then
            if [ "${ext}" = "sh" ] && [ ! -x "${cand}" ]; then
                printf '[srcradar] ERROR: %s exists but is not executable; chmod +x it first\n' "${cand}" >&2
                exit 4
            fi
            TARGET="${cand}"
            break 2
        fi
    done
done

if [ -z "${TARGET}" ]; then
    printf '[srcradar] ERROR: script "%s.{sh,py}" not found in %s/\n' "${SCRIPT}" "${MODULE_PATH}" >&2
    printf '       run "%s --list" to see available scripts\n' "${BASH_SOURCE[0]}" >&2
    exit 4
fi

# Dispatch: exec replaces this process so argv / $0 stays correct
# for the target script (its ${BASH_SOURCE[0]} resolves to itself,
# not back to this dispatcher).
# DB path resolution (done once at the top of ./srcradar, so the sub-scripts do
# not each assemble their own path):
#   1) env: $RECON_DB / $DB (explicitly exported by the user)
#   2) recon_db_path in config/db.conf (via modules/main/lib/load_config.sh,
#      the same mechanism as config/pdtm.conf; load_config_set returns 0
#      silently when the file does not exist, so docker / clean clone and
#      similar scenarios are not blocked)
#   3) hardcoded image path /opt/srcradar/db/recon.sqlite3 (the default landing
#      spot of the docker entrypoint init-db)
#   4) compatibility with the old mount /data/recon.sqlite3 (the early
#      srcradar-data volume)
#   5) nothing matches -> each sub-script uses its own default
#      (<repo>/modules/main/db/...)
if [ -z "${RECON_DB:-}" ] && [ -z "${DB:-}" ]; then
    # shellcheck disable=SC1091
    source "${ROOT_DIR}/modules/main/lib/load_config.sh"
    load_config_set "${ROOT_DIR}/config/db.conf" "${ROOT_DIR}/modules/main/lib" || true
    if [ -n "${recon_db_path:-}" ]; then
        export RECON_DB="${recon_db_path}"
        export DB="${recon_db_path}"
    elif [ -f /opt/srcradar/db/recon.sqlite3 ]; then
        export RECON_DB=/opt/srcradar/db/recon.sqlite3
        export DB=/opt/srcradar/db/recon.sqlite3
    elif [ -f /data/recon.sqlite3 ]; then
        export RECON_DB=/data/recon.sqlite3
        export DB=/data/recon.sqlite3
    fi
fi
# some module scripts (e.g. pdtm/scan.sh) assume CWD is their own directory.
# use the module directory as CWD so the user does not have to cd manually.
# exception: the daily/dashboard alias requires CWD in lib/ (dashboard.py
# imports sibling modules)
if [ -n "${ALIAS_DAILY_LIB:-}" ]; then
    cd "${ROOT_DIR}/modules/main/daily/lib"
else
    cd "${ROOT_DIR}/${MODULE_PATH}"
fi
case "${TARGET}" in
    *.sh) exec "${TARGET}" "$@" ;;
    *.py) exec python3 "${TARGET}" "$@" ;;
    *)    printf '[srcradar] ERROR: %s has unsupported extension\n' "${TARGET}" >&2; exit 6 ;;
esac
