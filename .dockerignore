# ============================================================================
# .dockerignore — keep the build context small
#
# srcradar build context = current repo root (Dockerfile expects modules/ at
# root, srcradar dispatcher, etc.). We exclude:
#   - everything gitignored (.gitignore is source of truth for vendor/build)
#   - Python caches
#   - local data, logs, configs
# ============================================================================

# ---- git (rebuild context has no need) ----
.git
.gitignore

# ---- vendored upstream ----
# db_align 与 ymicp 不属于本次发布范围:整个模块目录排除,构建上下文里
# 就没有它们(Dockerfile 里也会再删一次,双保险)。
modules/public/db_align/
modules/public/ymicp/
# pdtm 的 vendor: cdncheck(本仓 in-tree,go.mod replace 指向 ../cdncheck)
modules/main/pdtm/cdncheck/

# ---- srcradar 自己 vendor 的上游源码(.vendor/ 不进 git 但需要进 image)----
# 不排除 .vendor/ 本身(Dockerfile step 4 COPY 它)
# 但要剥掉 .vendor/ 内的 .claude/ 和 .git/ (如果有)
.vendor/**/.claude/
.vendor/**/.git/
.vendor/**/code.bak.*

# ---- build artifacts ----
modules/main/pdtm/bin/
modules/public/db_align/bin/
modules/main/pdtm/cdnmatch/cdncheck
**/*.test
**/*.out

# ---- runtime data (generated, not source) ----
modules/main/db/*.sqlite3*
modules/main/db/recon.sqlite3*
scan_results/
scan_outputs/
logs/
*.log
# The runtime files of the pdtm module. They are gitignored, so they sit in
# the source tree as leftovers of a previous run; the build context copies
# them and the image then refuses to run ("leftover runtime files of a
# previous run were detected in the pdtm CWD").
modules/main/pdtm/alive.txt
modules/main/pdtm/alterx.txt
modules/main/pdtm/dnsx_output.txt
modules/main/pdtm/scan_results/
modules/main/pdtm/scan_outputs/
modules/main/pdtm/target.txt
modules/main/pdtm/exclude.txt
modules/main/pdtm/wildcard.txt
modules/main/pdtm/no_wildcard.txt
modules/main/daily/reports/
modules/main/daily/snapshots/2*.json
modules/main/daily/.lock
modules/main/daily/logs/
modules/public/db_align/logs/
modules/public/db_align/.claude/
modules/public/ymicp/logs/

# ---- Python caches ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- temp / backup ----
*.bak
*.orig
*.rej
*.tmp
.tmp/

# ---- Hermes / Claude agent workspace (NEVER ship into image) ----
.hermes/

# ---- private modules (per .gitignore: future internal only) ----
modules/private/*
!modules/private/.gitkeep

# ---- the standalone repos (cloned inside the image, not in the context) ----
modules/public/srcradar-mcp-server/
modules/public/algo_diff_cpp/

# ---- local config (user-specific; mount at runtime) ----
config/*
!config/.gitkeep
*.local.yaml
*.local.yml
.env
.env.*

# ---- docs / extras (not needed in image; image is executable, not docs) ----
*.md
!README.md
!LICENSE
!NOTICE
!TERMS_ADDENDUM.md
!TERMS_ADDENDUM_zh.md
assets/

# ---- CI files (not needed in image) ----
.github/

# ---- the docker files themselves (avoid self-reference in build context) ----
# 但 entrypoint.sh / healthcheck.sh / MODIFICATIONS.txt 必须 COPY 进 image
# 所以只排除顶层 Dockerfile 和 docker-compose.yml
# Dockerfile:不 COPY(我们用 builder /out-bin + COPY modules/,不需要 Dockerfile)
# docker-compose.yml:用户外部编排,不入 image
