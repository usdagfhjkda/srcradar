# ============================================================================
# srcradar .gitignore
#
# 重构后布局:
#   - 入口脚本在根 (init.sh / install.sh / install-internal.sh / check.sh)
#   - 代码全部入 modules/{main, public, private}/
#   - main 模块必装: pdtm/daily/manage/db
#   - public 模块选装: db_align/ymicp
#   - private 模块: 现阶段占位 (.gitkeep),未来装内部模块
#
# 上游 fork (projectdiscovery/cdncheck, wgpsec/ENScan_GO) 由对应模块的
# install.sh 拉取,不入 git。
# ============================================================================

# ---- 1. 上游 fork(vendor)目录:不进 git ----
# db_align 的 vendor: ENScan_GO
modules/public/db_align/ENScan_GO/

# pdtm 的 vendor: cdncheck(本仓 in-tree,go.mod replace 指向 ../cdncheck)
modules/main/pdtm/cdncheck/

# ---- 2. 运行时产物 ----
# SQLite 数据库(运行后生成,内部含业务数据,不应入库)
modules/main/db/*.sqlite3
modules/main/db/*.sqlite3-journal
modules/main/db/*.sqlite3-wal
modules/main/db/*.sqlite3-shm
modules/main/db/recon.sqlite3*

# DNSlog / cookie / token 等凭据与运行时缓存
cookie.log
.env
.env.*
*.local.yaml
*.local.yml

# 扫描输出 / 日志 / snapshot
scan_results/
scan_outputs/
logs/
*.log
modules/main/daily/reports/
modules/main/daily/snapshots/2*.json
modules/main/daily/.lock
modules/main/daily/logs/
modules/public/db_align/logs/
modules/public/db_align/.claude/

# Go 构建产物
**/*.test
**/*.out
modules/main/pdtm/bin/
modules/public/db_align/bin/
modules/public/db_align/ENScan_GO/ENScan
*.exe

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 临时 / 备份
*.bak
*.orig
*.rej
*.tmp
.tmp/

# Hermes 本地(skill/plans/agent 配置)
.hermes/

# ---- 3. 私有模块目录(未来内部使用,现阶段只留 .gitkeep) ----
modules/private/*
!modules/private/.gitkeep

# ---- 4. 上游依赖管理 ----
.vendor/
